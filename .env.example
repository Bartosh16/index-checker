DATABASE_URL="postgresql://postgres:postgres@localhost:5432/index_checker?schema=public"

# Notes:
# - .env can keep your base defaults
# - secrets entered from the UI are written to .env.local
# - .env.local is ignored by git and wins over .env

# Core checker settings
CHECK_PROVIDER="AUTO"
SERP_QUERY_STRATEGY="SITE_THEN_URL"

# Managed SERP providers
SERPER_API_KEY=""
SERPAPI_API_KEY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
DATAFORSEO_LOCATION_CODE=""
DATAFORSEO_LOCATION_NAME=""
DATAFORSEO_LANGUAGE_CODE="pl"
SEARXNG_BASE_URL=""
SEARXNG_ENGINES="google"

# Google Search Console
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
GSC_LANGUAGE_CODE="pl-PL"

# Email notifications (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
DEFAULT_NOTIFICATION_EMAIL=""

# Runtime tuning
CHECK_BATCH_SIZE="25"
CHECK_CACHE_DAYS="7"
